# PetAlert - InfinityFree Compatible .htaccess
Options -Indexes

# Charset e tipos
AddDefaultCharset UTF-8

# Página inicial padrão
DirectoryIndex index.html index.php

# Bloquear acesso a arquivos sensíveis
<FilesMatch "^(\.env|\.gitignore|composer\.json|composer\.lock)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Bloquear acesso direto a pastas de back-end
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Permite acesso direto a arquivos e pastas existentes
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Redirecionar rotas de API (?rota=...) para public/index.php
    RewriteCond %{QUERY_STRING} rota=
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^index\.php$ public/index.php [L,QSA]

</IfModule>

# Headers de segurança básicos
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options SAMEORIGIN
</IfModule>
